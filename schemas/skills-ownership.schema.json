{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Praxity skill adapter ownership and recovery journal",
  "$ref": "#/$defs/record",
  "$defs": {
    "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "lock": {
      "type": "object", "required": ["pid", "token"], "additionalProperties": false,
      "properties": { "pid": { "type": "integer", "minimum": 1 }, "token": { "type": "string", "pattern": "^[a-f0-9-]{36}$" } }
    },
    "record": {
      "type": "object", "required": ["owner", "files"], "additionalProperties": false,
      "properties": {
        "owner": { "const": "praxity-toolkit" },
        "schemaVersion": { "enum": [1, 2] },
        "host": { "enum": ["t3", "claude", "codex"] },
        "hosts": { "type": "array", "items": { "enum": ["claude", "codex"] } },
        "files": { "$ref": "#/$defs/files" },
        "lock": { "$ref": "#/$defs/lock" },
        "transaction": { "$ref": "#/$defs/transaction" }
      },
      "oneOf": [
        { "required": ["schemaVersion", "hosts"], "properties": { "schemaVersion": { "const": 2 }, "host": { "enum": [] } } },
        { "required": ["host"], "properties": { "schemaVersion": { "const": 1 }, "hosts": { "enum": [] } } },
        { "properties": { "schemaVersion": { "enum": [] }, "host": { "enum": [] }, "hosts": { "enum": [] }, "files": { "type": "object", "additionalProperties": false } } }
      ]
    },
    "transaction": {
      "type": "object", "required": ["phase", "previous", "next", "lock", "staged"], "additionalProperties": false,
      "properties": {
        "phase": { "enum": ["stage", "remove"] },
        "previous": { "$ref": "#/$defs/files" },
        "next": { "allOf": [ { "$ref": "#/$defs/record" }, { "properties": { "lock": { "enum": [] }, "transaction": { "enum": [] } } } ] },
        "lock": { "$ref": "#/$defs/lock" },
        "staged": {
          "type": "array", "items": {
            "type": "object", "required": ["name", "temp"], "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "temp": { "type": "string" } }
          }
        }
      }
    }
  }
}
